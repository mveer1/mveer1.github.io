{
  "name": "mveer1.github.io",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio of Mahavir Chaudhari, Data Engineer: an explorable 3D world of brick-built islands. Zero-build static site (HTML, CSS, ES modules, Three.js from a CDN) served directly by GitHub Pages; npm is used only for local dev and browser QA.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "http-server . -p 8080 -c-1",
    "check": "node --check js/main.js && node --check js/app.js",
    "guide": "node tools/render-guide.mjs",
    "preload": "node tools/preload.mjs",
    "qa": "node qa/interact.mjs",
    "qa:tour": "node qa/tour.mjs --panels",
    "qa:storyboard": "node qa/storyboard.mjs"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "playwright": "^1.56.1",
    "three": "0.170.0",
    "vite": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mveer1/mveer1.github.io.git"
  },
  "keywords": [
    "portfolio",
    "data-engineering",
    "github-pages"
  ],
  "author": "Mahavir Chaudhari",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mveer1/mveer1.github.io/issues"
  },
  "homepage": "https://mveer1.github.io"
}
